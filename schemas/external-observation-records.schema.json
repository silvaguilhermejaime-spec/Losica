{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://losica.local/schemas/external-observation-records.schema.json",
  "title": "Descriptions aligned to recorded experience",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["external_id", "expression", "source_offset_ranges"],
    "properties": {
      "external_id": {"type": "string", "minLength": 1},
      "expression": {"type": "string", "minLength": 1},
      "source_offset_ranges": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
