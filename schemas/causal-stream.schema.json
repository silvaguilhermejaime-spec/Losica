{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://losica.local/schemas/causal-stream.schema.json",
  "title": "Losica causal stream",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "frames", "source_sha256"],
  "properties": {
    "schema": {"const": "losica-causal-stream/1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frames": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "samples", "controls", "source_offset"],
        "properties": {
          "t": {"type": "number"},
          "samples": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "controls": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "source_offset": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
