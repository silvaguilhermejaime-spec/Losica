  "causal_rule": {
    "generation_input": "numeric records from the observed recording",
    "external_alignment_input": "externally authored expression plus a pointer into that same recording",
    "forbidden_edge": "external expression -> generated semantic region",
    "allowed_edge": "recording range -> generated event IDs -> generated region IDs; external expression is attached to the recording range afterward"
  },
  "score_rubric": {
    "range": "integer 0 through 10",
    "formula": "evidence_link + signal_access + human_wording + setting_coverage + losica_fit",
    "components": {
      "evidence_link": {"0": "text only", "1": "clip or episode", "2": "time, frame, sample, or bounding-box link"},
      "signal_access": {"0": "signal unavailable", "1": "derived signal, restricted signal, or simulation", "2": "real raw recording obtainable under stated terms"},
      "human_wording": {"0": "machine-written", "1": "fixed templates or automatic parses", "2": "human free wording"},
      "setting_coverage": {"0": "no observed setting", "1": "one narrow setting", "2": "several everyday settings"},
      "losica_fit": {"0": "cannot share observation offsets", "1": "episode converter required", "2": "source pointers can map directly to offsets"}
    }
  },
